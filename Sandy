#!/bin/bash
clear
echo "=============================================="
echo "     WHATSAPP REPORT TOOL - TERMUX            "
echo "=============================================="
for cmd in curl jq python3; do
command -v $cmd &>/dev/null || pkg install $cmd -y
done
read -p "Nomor target (62xxx): " TARGET
read -p "Alasan (1=spam 2=scam 3=abuse 4=other): " REASON
case $REASON in
1) R="Spam" ;;
2) R="Scam" ;;
3) R="Abuse" ;;
*) R="Other" ;;
esac
read -p "Jumlah report (default 100): " COUNT
COUNT=${COUNT:-100}
report(){
curl -s -X POST "https://www.whatsapp.com/contact/noclient/" \
-H "User-Agent: Mozilla/5.0 (Linux; Android 10)" \
-H "Content-Type: application/x-www-form-urlencoded" \
-d "email=&phone=$1&country=62&reason=$2&message=Report+for+$2" \
-o /dev/null -w "%{http_code}"
}
S=0; F=0
for ((i=1;i<=COUNT;i++)); do
C=$(report "$TARGET" "$R")
if [[ "$C" == "200" || "$C" == "302" ]]; then
((S++)); echo "[+] $i/$COUNT OK ($C)"
else
((F++)); echo "[-] $i/$COUNT FAIL ($C)"
fi
sleep $((RANDOM % 3 + 1))
done
echo "=============================================="
echo "Target : $TARGET"
echo "Alasan : $R"
echo "Sukses : $S"
echo "Gagal  : $F"
echo "=============================================="
echo "$TARGET | $R | $S/$COUNT | $(date)" >> ~/wa_report_log.txt
